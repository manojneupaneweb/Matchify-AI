{
  "name": "ai-analytics-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "eval": "tsx evals/run.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,json,css,md}": [
      "prettier --write"
    ],
    "*.{ts,tsx,mjs}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "framer-motion": "^12.38.0",
    "jose": "^6.2.13",
    "lucide-react": "^1.8.0",
    "mongoose": "^9.4.1",
    "next": "16.2.4",
    "next-auth": "^4.24.14",
    "pdf-parse": "^1.1.1",
    "postcss": "^8.5.10",
    "react": "19.2.4",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
