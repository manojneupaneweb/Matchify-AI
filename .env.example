# Google Gemini. Required for analysis, JD generation, and cover letters.
GEMINI_API_KEY=

# Primary model, then fallback if the primary returns 429 or 5xx.
GEMINI_MODEL_PRIMARY=gemini-2.5-flash
GEMINI_MODEL_FALLBACK=gemini-2.0-flash

# MongoDB connection string (database name included).
MONGODB_URI=

# Public origin NextAuth uses for callbacks. No trailing path.
NEXTAUTH_URL=http://localhost:3000

# Secret for NextAuth JWT encryption. Use a long random string.
NEXTAUTH_SECRET=

# Secret for the credentials-login JWT (jose). Required; there is no fallback.
JWT_SECRET=

# Google OAuth (NextAuth provider).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (NextAuth provider).
GITHUB_ID=
GITHUB_SECRET=

# Optional. This email is treated as admin in addition to users whose role is "admin".
ADMIN_EMAIL=

# Optional Upstash Redis REST credentials for shared rate limits.
# When unset, the app uses an in-memory limiter (fine for a single local process).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Analyses allowed per user and per IP inside the window.
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000

# Set to "1" only in test/CI so Playwright can skip OAuth. Ignored when NODE_ENV=production.
E2E_AUTH_BYPASS=
